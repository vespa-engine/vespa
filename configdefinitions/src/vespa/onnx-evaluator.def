package=ai.vespa.modelintegration.evaluator.config

executionMode enum { parallel, sequential } default=sequential
interOpThreads int default=1
intraOpThreads int default=-4
# GPU device id, -1 for CPU
gpuDevice int default=0

# Controls ONNX graph optimization. Default is on.
optimizeModel bool default=true

# Controls dynamic batching that combines up to `maxSize` requests into a single inference call.
# This increases throughput.
# This is especially effective for generating embeddings during feeding on GPU.
# The default settings disables dynamic batching.
batching.maxSize int default=1
# TODO: Deprecated and ignored. Remove in Vespa 9.
batching.maxDelayMillis long default=0

# Controls the number of requests processed concurrently.
# This applies only to Triton runtime, embedded runtime has no explicit concurrency control.
# For Triton, concurrency determines how many model instances are created.
# With `factorType=absolute`, `factor` is rounded to the number of model instances.
# With `factorType=relative`, `factor` is multiplied by the number of CPU cores and rounded to the number of model instances.
# With `factor<=0`, the number of model instances is configured automatically based on the device and runtime.
# Explicit values in services.xml must be positive; omit the concurrency element to use the automatic default.
concurrency.factorType enum { absolute, relative } default=absolute
concurrency.factor double default=0.0

# Path to model config file, e.g. `config.pbtxt` used by Triton inference server.
modelConfigOverride path optional
