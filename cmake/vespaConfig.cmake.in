# This file contains some of the vespa cmake config needed for other
# cmake projects depending on vespa.

set(VESPA_VERSION @VESPA_VERSION@)
@PACKAGE_INIT@
set_and_check(VESPA_INCLUDE_DIR "@PACKAGE_INCLUDE_INSTALL_DIR@")
set_and_check(VESPA_HOME "@PACKAGE_INSTALL_PREFIX_DIR@")
set_and_check(VESPA_CMAKECONFIG_DIR "@PACKAGE_CMAKECONFIG_DIR@")
include(CMakeFindDependencyMacro)
find_dependency(Threads REQUIRED)
find_dependency(BISON REQUIRED 3.0)
find_dependency(FLEX REQUIRED 2.5)
find_dependency(LLVM CONFIG REQUIRED)
find_dependency(ICU 60.0 REQUIRED COMPONENTS uc i18n)
find_dependency(OpenSSL CONFIG REQUIRED)
find_dependency(absl CONFIG REQUIRED)
find_dependency(re2 CONFIG REQUIRED)
find_dependency(GTest CONFIG REQUIRED)
find_dependency(Protobuf CONFIG REQUIRED)
find_dependency(gRPC CONFIG REQUIRED)
find_dependency(opentelemetry-cpp CONFIG REQUIRED COMPONENTS api sdk exporters_ostream exporters_in_memory exporters_otlp_grpc)
include("${CMAKE_CURRENT_LIST_DIR}/vespaTargets.cmake")
check_required_components(vespa)
message(STATUS "Found vespa ${VESPA_VERSION} at ${VESPA_HOME}")
