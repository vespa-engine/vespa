# TODO (@sebasabe): Remove when Vespa Cloud no longer validates <commerce-discovery> against this schema; <product-discovery> replaces it
CommerceDiscovery = CommerceDiscoveryV1

CommerceDiscoveryV1 = element commerce-discovery {
   attribute version { xsd:string { pattern = "[0-9]+\.[0-9]+" } } &
   CommerceDiscoveryProduct? &
   CommerceDiscoveryCategory? &
   element variant-presentation { empty }? &
   element ranking-tags-registry { empty }?
}

CommerceDiscoveryProduct = element product {
   attribute document-type { text }? &
   attribute namespace { text }? &
   attribute id-field { text }?
}

CommerceDiscoveryCategory = element category {
   attribute document-type { text }? &
   attribute namespace { text }? &
   attribute id-field { text }?
}
