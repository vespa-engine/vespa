<services version="1.0">

  <container version="1.0">
    <component id="lateon" type="colbert-embedder">
      <transformer-model model-id="lightonai-lateon" url="https://my/url/model.onnx"/>
      <tokenizer-model model-id="lightonai-lateon-vocab" url="https://my/url/tokenizer.json"/>
    </component>

    <component id="lateon-overridden" type="colbert-embedder">
      <transformer-model model-id="lightonai-lateon-int8" url="https://my/url/model_int8.onnx"/>
      <tokenizer-model model-id="lightonai-lateon-vocab" url="https://my/url/tokenizer.json"/>
      <max-document-tokens>512</max-document-tokens>
    </component>

    <component id="outer" class="com.example.Outer" bundle="outer">
      <component id="nested-lateon" type="colbert-embedder">
        <transformer-model model-id="lightonai-lateon" url="https://my/url/model.onnx"/>
        <tokenizer-model model-id="lightonai-lateon-vocab" url="https://my/url/tokenizer.json"/>
      </component>
    </component>

    <nodes>
      <node hostalias="node1" />
    </nodes>
  </container>

</services>
