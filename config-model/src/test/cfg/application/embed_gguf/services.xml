<services version="1.0">
    <container id="container" version="1.0">

        <component id="gguf-full" type="gguf-embedder">
            <transformer-model model-id="llama-3.2-1b" url="https://my/url/model.gguf"/>
            <mmproj-model url="https://my/url/mmproj.gguf"/>
            <image-first>false</image-first>
            <image-min-tokens>250</image-min-tokens>
            <image-max-tokens>280</image-max-tokens>
            <max-tokens>512</max-tokens>
            <normalize>true</normalize>
            <pooling-strategy>last</pooling-strategy>
            <prepend>
                <query>query: </query>
                <document>passage: </document>
            </prepend>
            <parallel>4</parallel>
            <context-size>8192</context-size>
            <logical-max-batch-size>2048</logical-max-batch-size>
            <physical-max-batch-size>1024</physical-max-batch-size>
            <gpu-layers>99</gpu-layers>
            <seed>42</seed>
            <threads>-0.5</threads>
            <batch-threads>6</batch-threads>
        </component>

        <component id="gguf-minimal" type="gguf-embedder">
            <transformer-model path="models/embedder.gguf"/>
        </component>

    </container>
</services>
