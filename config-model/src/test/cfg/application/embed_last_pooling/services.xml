<services version="1.0">
  <container id="container" version="1.0">
    <component id="hf-embedder" type="hugging-face-embedder">
      <transformer-model url="https://my/url/model.onnx"/>
      <tokenizer-model url="https://my/url/tokenizer.json"/>
      <pooling-strategy>last</pooling-strategy>
    </component>
    <component id="bert-embedder" type="bert-embedder">
      <transformer-model url="https://my/url/model.onnx"/>
      <tokenizer-vocab url="https://my/url/vocab.txt"/>
      <pooling-strategy>last</pooling-strategy>
    </component>
    <nodes>
      <node hostalias="node1"/>
    </nodes>
  </container>
</services>
