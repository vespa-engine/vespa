# Normalized feature names below must stay in sync with searchlib/src/tests/features/bm25/bm25_test.cpp.
schema bm25label {

    document bm25label {
        field myfield type string {
            indexing: index
            index: enable-bm25
        }
    }

    rank-profile default {
        first-phase {
            expression: bm25(myfield)
        }
        match-features {
            bm25(myfield)
            bm25(field: myfield, label: mylabel)
            bm25(myfield, label: mylabel)
        }
        summary-features {
            bm25(myfield)
            bm25(field: myfield, label: mylabel)
            bm25(myfield, label: mylabel)
        }
    }

    rank-profile quoted-field {
        first-phase {
            expression: bm25(field: "myfield", label: mylabel)
        }
        match-features {
            bm25(field: "myfield", label: mylabel)
        }
    }

    rank-profile labels {
        first-phase {
            expression: reduce(bm25_for_labels(myfield), max, label)
        }
        match-features {
            bm25_for_labels(myfield)
        }
    }

    rank-profile label-slice {
        first-phase {
            expression: bm25_for_labels(myfield){label:mylabel}
        }
    }
}
