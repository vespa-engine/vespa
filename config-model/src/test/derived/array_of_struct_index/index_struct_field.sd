schema index_struct_field {
    struct simple {
        field myvalue type string {}
    }
    struct normal {
        field mykey type int {}
        field myvalue type string {}
    }
    struct complex {
        field a type int {}
        field b type string {}
        field c type string {}
        field d type string {}
    }
    struct settings {
        field nostem type string {}
        field shortest type string {}
        field nonorm type string {}
        field bm25 type string {}
        field ranktype type string {}
        field weighted type string {}
        field ling type string {}
        field tokens type string {}
    }
    document index_struct_field {

        field array_of_int type array<int> {
            indexing: attribute
        }

        field array_of_string type array<string> {
            indexing: index
        }

        # This should give basically same result as above,
        # only with an index named "array_of_simple.myvalue"
        field array_of_simple type array<simple> {
            struct-field myvalue {
                indexing: index
            }
        }

        # This should give basically the same as
        # array_of_int + array_of_string, with
        # an attribute named "array_of_normal.mykey"
        # and an index named "array_of_normal.myvalue"
        field array_of_normal type array<normal> {
            struct-field mykey {
                indexing: attribute
            }
            struct-field myvalue {
                indexing: index
            }
        }

        # This should give the same as the above, with
        # an attribute named "map_int_to_string.key"
        # and an index named "map_int_to_string.value"
        field map_int_to_string type map<int, string> {
            struct-field key {
                indexing: attribute
            }
            struct-field value {
                indexing: index
            }
        }

        # This should give indexes named "map_string_to_normal.key"
        # and "map_string_to_normal.value.myvalue", and an attribute
        # named "map_string_to_normal.value.mykey"
        field map_string_to_normal type map<string, normal> {
            indexing: summary
            struct-field key {
                indexing: index
            }
            struct-field value.mykey {
                indexing: attribute
            }
            struct-field value.myvalue {
                indexing: index
            }
        }

        field array_of_complex type array<complex> {
            struct-field a {
                indexing: attribute
            }
            struct-field b {
                indexing: index
            }
            struct-field c {
                indexing: index
                rank: filter
            }
            struct-field d {
                indexing: index
                match: exact
            }
        }

        # Index related settings given in struct-field blocks
        # apply to the corresponding struct field indexes
        field array_of_settings type array<settings> {
            struct-field nostem {
                indexing: index
                stemming: none
            }
            struct-field shortest {
                indexing: index
                stemming: shortest
            }
            struct-field nonorm {
                indexing: index
                normalizing: none
            }
            struct-field bm25 {
                indexing: index
                index: enable-bm25
            }
            struct-field ranktype {
                indexing: index
                rank-type: identity
            }
            struct-field weighted {
                indexing: index
                weight: 200
            }
            struct-field ling {
                indexing: index
                linguistics {
                    profile: p1
                }
            }
            struct-field tokens {
                indexing: index
                linguistics {
                    tokens: alternatives
                }
            }
        }

        # The same for the key and the struct fields of the value in a map
        field map_of_settings type map<string, settings> {
            struct-field key {
                indexing: index
                stemming: none
            }
            struct-field value {
                struct-field bm25 {
                    indexing: index
                    index: enable-bm25
                }
                struct-field ranktype {
                    indexing: index
                    rank-type: identity
                }
                struct-field weighted {
                    indexing: index
                    weight: 300
                }
                struct-field ling {
                    indexing: index
                    linguistics {
                        profile: p1
                    }
                }
            }
        }
    }

    # Struct field indexes are indexes also when used in a fieldset
    fieldset struct_values {
        fields: array_of_simple.myvalue, map_string_to_normal.value.myvalue
    }
}
