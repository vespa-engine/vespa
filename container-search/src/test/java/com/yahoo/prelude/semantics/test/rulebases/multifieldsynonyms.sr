(index1, index2):[synonyms1] -> =*:[synonyms1*]; # Replace by equiv(foo, bar, baz) in the matched field
(index1, index2):[synonyms2] +> =*:[synonyms2*]; # Add equiv(word, "a phrase") in the matched field

[synonyms1] :- foo, baz, bar;
[synonyms2] :- word, a phrase;
